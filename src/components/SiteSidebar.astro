---
import { NAV_ITEMS } from "@/constants/site.constant";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const isActive = (href: string) => pathname === href;
---

<nav class="sidebar">
  <div class="sidebar__nav">
    {
      NAV_ITEMS.map((item) => (
        <a
          class:list={["sidebar__nav-link", { "is-active": isActive(item.href) }]}
          href={item.href}
          data-sidebar-link
          data-keybinding={item.keybinding}
        >
          <span class="sidebar__nav-keybinding">[{item.keybinding}]</span>
          <span class="sidebar__nav-label">{item.label}</span>
        </a>
      ))
    }
    <button
      class="sidebar__nav-link sidebar__nav-link--button"
      type="button"
      aria-label="Toggle theme"
      data-theme-toggle
    >
      Theme
    </button>
  </div>
</nav>
