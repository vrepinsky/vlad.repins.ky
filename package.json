{
  "name": "vlad.repins.ky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot scripts/dev.ts",
    "dev:watch": "bun --watch scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "preview": "bun run build && bun scripts/serve-dist.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx oxlint src scripts",
    "lint:fix": "bunx oxlint --fix src scripts",
    "format": "bunx oxfmt src scripts",
    "format:check": "bunx oxfmt --check src scripts"
  },
  "dependencies": {
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  }
}
